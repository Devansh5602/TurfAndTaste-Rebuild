    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
